# TripSi API — Environment Variables             
# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tripsi_dev
DB_USERNAME=tripsi
DB_PASSWORD=tripsi

# ── JWT Authentication ──
# Generate with: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-here-replace-me
JWT_EXPIRATION_MS=86400000

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Spring AI (LLM Provider) ──
OPENAI_API_KEY=sk-your-openai-key-here

# ── Duffel API (Flight Search) ──
DUFFEL_API_KEY=duffel_test_your-key-here
DUFFEL_API_URL=https://api.duffel.com

# ── Spring Profile ──
SPRING_PROFILES_ACTIVE=dev
